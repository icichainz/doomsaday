<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Outgoing connections to the agent over pinned HTTPS. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required by the Flutter tool to talk to the running debug VM. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- The keychain group lives in Release.entitlements only: it forces the
	     build to be signed with a development certificate, which an unsigned
	     local debug build has none of. Without it flutter_secure_storage
	     answers -34018, which the app detects and explains on pairing. -->
</dict>
</plist>
